# Copy to /etc/tradeiq.env on a VPS. Keep it root-owned with mode 0600.
# Set a unique APP_PASSWORD of at least 16 characters before starting.
NODE_ENV=production
HOST=127.0.0.1
PORT=3100
PUBLIC_HOST=opaux.com
COOKIE_SECURE=true
DATABASE_PATH=/var/lib/tradeiq/tradeiq.sqlite
APP_PASSWORD=
GOOGLE_PLACES_API_KEY=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=gordon@kleankickx.com
SMTP_PASS=
SMTP_FROM_NAME="Gordon | Kleankickx"
# Do not set the Codex-only SMTP_PROXY on your Hostinger server.
